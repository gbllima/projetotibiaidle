{
  "name": "tibia-idle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "datagen": "pnpm --filter @tibia-idle/datagen start",
    "icons:patch": "python tools/extractor/patch_item_icons.py",
    "mapcut": "node tools/mapcut/cut-hunts.mjs",
    "attack:pack": "python tools/scripts/pack-attack-effects.py",
    "dev": "pnpm --parallel --filter \"./apps/**\" dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "vitest": "^2.1.8"
  }
}
